  "providers": [
    {
      "id": "searxng.local",
      "kind": "local",
      "adapter_id": "yonerai.search-gateway",
      "capabilities": ["web.search"],
      "enabled": true,
      "resources": {
        "target": "cpu",
        "max_concurrency": 4,
        "system_ram_budget_mb": 1024,
        "load_policy": "always_loaded",
        "offload_policy": "disabled",
        "exclusive_gpu_lease": false
      },
      "setting_refs": ["env:YONERAI_SEARCH_GATEWAY_URL"],
      "timeouts": {
        "request_seconds": 12,
        "health_seconds": 3
      }
    }
  ],
  "routes": [
