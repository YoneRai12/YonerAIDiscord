# Discord Developer Portalで発行したBotトークン。実値はコミットしないでください。
DISCORD_TOKEN=

# 開発中はテストサーバーIDを指定するとスラッシュコマンドの反映が速くなります。
DISCORD_GUILD_ID=0

# 複数サーバーへ同期するID（カンマ区切り）。重複は除去され、DISCORD_GUILD_IDも指定時は同期対象に含まれます。
# guild同期対象が一つでもある場合は、SYNC_GLOBAL_COMMANDS=trueでも既存方針どおりglobal同期を実行しません。
COMMAND_SYNC_GUILD_IDS=

# 本番のglobal command同期は反映範囲が広いため、明示した時だけ実行します。
SYNC_GLOBAL_COMMANDS=false

DATABASE_PATH=data/yonerai-discord.sqlite3
LOG_LEVEL=INFO
LOG_PATH=logs/yonerai-discord.jsonl
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
SHUTDOWN_TIMEOUT_SECONDS=15

# Bot全体の所有者。複数の場合はカンマ区切り。秘密値ではありません。
BOT_OWNER_IDS=
TRUSTED_ROLE_IDS=
MODERATOR_ROLE_IDS=

# 656件のcanonical capability台帳。通常は変更不要です。
CAPABILITY_CATALOG_PATH=docs/CAPABILITY_COUNTS.json

# カンマ区切り。空なら監査済みの既定セットを起動します。
# 将来のexperimental pluginだけは、このallowlistと隔離解除の両方が必要です。
ENABLED_PLUGINS=
ALLOW_QUARANTINED_PLUGINS=false

# welcome/goodbyeを使う場合のみtrue。Developer PortalのServer Members Intentも手動でONにします。
SERVER_MEMBER_EVENTS_ENABLED=false
# message edit/delete監査を使う場合のみtrue。本文取得のMessage Content Intentは使いません。
SERVER_MESSAGE_AUDIT_EVENTS_ENABLED=false

# report-only AutoModのprocess全体switch。true時はDeveloper PortalのMessage Content Intentも必要です。
AUTOMOD_ENABLED=false

# 本人確認はplugin allowlistとこのowner側switchの二重opt-inです。
# 公開運用はHTTPS URLとCloudflare Turnstile secretが必須です。secretをcommitしないでください。
IDENTITY_ENABLED=false
IDENTITY_PUBLIC_BASE_URL=
IDENTITY_TURNSTILE_SECRET=
# 内蔵callback serverはloopbackだけにbindし、Cloudflare Tunnel等で公開します。
IDENTITY_HTTP_ENABLED=false
IDENTITY_HTTP_HOST=127.0.0.1
IDENTITY_HTTP_PORT=8765
IDENTITY_TURNSTILE_SITE_KEY=
# ローカル開発だけの例外。公開環境では必ずfalseのままにします。
IDENTITY_ALLOW_INSECURE_LOCALHOST=false

# AIはResponses APIを利用。通常Terra、複雑・高リスクはSol、極小で無害な処理だけLunaです。
AI_BASE_URL=https://api.openai.com/v1
# 実行profileは3項目を同時に指定します。空欄はLocal/full_private_self_host/local_onlyの安全な既定です。
# AI_EXECUTION_TOPOLOGY: local_standalone|direct_core|discord_processing|hybrid
# AI_HOSTING_PROFILE: official_managed|official_hybrid_private|full_private_self_host
# AI_PACKAGING_CANDIDATE: public_safe_shared|official_private|local_only|undecided
# nonlocalはcode-owned gateway portの注入が必要です。不足時にLocalへfallbackせずfail closedします。
AI_EXECUTION_TOPOLOGY=
AI_HOSTING_PROFILE=
AI_PACKAGING_CANDIDATE=
# OpenAI公式endpointでだけ使用します。実値をcommitしないでください。
OPENAI_API_KEY=
# GPT Image 2の生成/編集は、plugin/module/capabilityに加えてこの明示opt-inが必要です。
IMAGE_OPENAI_ENABLED=false
# BOT専用ACLで事前作成した既存directoryの絶対pathだけを指定します。
IMAGE_ARTIFACT_ROOT=
IMAGE_OPENAI_TIMEOUT_SECONDS=90
# provider-neutral STT/TTS/music/video生成は各plugin・module・capabilityに加えて個別opt-inが必要です。
# すべて既定OFF。artifact rootはBOT専用ACLで事前作成した既存の絶対directoryだけを指定します。
STT_OPENAI_ENABLED=false
STT_OPENAI_TIMEOUT_SECONDS=120
TTS_VOICEVOX_ENABLED=false
TTS_ARTIFACT_ROOT=
TTS_VOICEVOX_TIMEOUT_SECONDS=60
MUSIC_ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
MUSIC_GENERATION_ARTIFACT_ROOT=
MUSIC_ELEVENLABS_TIMEOUT_SECONDS=180
VIDEO_VEO_ENABLED=false
GEMINI_API_KEY=
VIDEO_ARTIFACT_ROOT=
VIDEO_VEO_TIMEOUT_SECONDS=600
# localhost等のOpenAI互換endpoint専用。公式OpenAIには送信しません。
AI_API_KEY=
# 所有者が外部AI送信を許可する場合だけtrue。利用者本人の永続同意は別途必要です。
AI_ALLOW_REMOTE=false
# BOTへの明示メンションだけをAI会話へ接続します。通常message全文の監視は行いません。
AI_MENTION_ENABLED=false
# カンマ区切りの明示allowlist。空ならDISCORD_GUILD_IDだけを許可します。
AI_MENTION_GUILD_IDS=
# 全参加guildを許可する危険な例外。通常はfalseのまま明示allowlistを使います。
AI_MENTION_ALLOW_ALL_GUILDS=false
# 複合Action planをSQLiteへcheckpointする場合だけ明示ON。通常はprocess内実行。
AI_ORCHESTRATION_DURABLE_ENABLED=false
AI_DM_ENABLED=false
# BOT返信へのDiscord replyを、再メンションなしで同じ短期会話として継続します。
AI_REPLY_CONTINUATION_ENABLED=false
# 明示メンションまたは継続replyに添付された画像・許可済みファイルを解析します。
AI_ATTACHMENTS_ENABLED=false
# AIメンション処理全体（返信元・添付読込から会話追記まで）の同時実行数と待機上限です。
AI_ADMISSION_GLOBAL_CONCURRENCY=4
AI_ADMISSION_MAX_WAITERS=32
AI_ADMISSION_WAIT_TIMEOUT_SECONDS=2
# 停止時に進行中のAI処理を待つ上限。SHUTDOWN_TIMEOUT_SECONDS未満にしてください。
AI_ADMISSION_DRAIN_TIMEOUT_SECONDS=5
# 外部provider本人同意はDiscordユーザー単位でSQLiteへ永続化します。0は無期限です。
# 本人の取消し、または同意policy/disclosure version変更時だけ再確認します。
AI_REMOTE_CONSENT_TTL_SECONDS=0
AI_REMOTE_CONSENT_MAX_GRANTS=1024
# 会話/過去添付はlocal providerとも共用し既定2時間。取消/再同意ならscope単位で即dropします。
AI_CONVERSATION_TTL_SECONDS=7200
AI_CONVERSATION_MAX_TURNS=12
# process内に同時保持する会話session数。超過時はTTL清掃後にLRUで古い会話から破棄します。
AI_CONVERSATION_MAX_SESSIONS=128
# 全会話を合計した添付binaryの上限（既定64MiB）。会話単体の上限以上にしてください。
AI_CONVERSATION_MAX_TOTAL_BINARY_BYTES=67108864
AI_ATTACHMENT_MAX_FILES=4
AI_ATTACHMENT_MAX_FILE_BYTES=8388608
AI_ATTACHMENT_MAX_TOTAL_BYTES=16777216
AI_ALLOW_LUNA=true
# YonerAI Search Fabric。通常検索はprivate gatewayを使い、外部vendorの検索課金へfallbackしません。
WEB_SEARCH_ENABLED=true
WEB_SEARCH_BACKEND=yonerai_search_gateway
YONERAI_SEARCH_GATEWAY_MODE=loopback
YONERAI_SEARCH_GATEWAY_URL=http://127.0.0.1:8787
SEARCH_MAX_QUERIES_PER_RUN=3
SEARCH_MAX_RESULTS=10
SEARCH_MAX_FETCHES=5
SEARCH_TIMEOUT_SECONDS=12
SEARCH_MAX_RESPONSE_BYTES=524288
SEARCH_FETCH_MAX_BYTES=2097152
SEARCH_CACHE_TTL_SECONDS=1800
SEARCH_RAW_QUERY_RETENTION_SECONDS=0
SEARCH_REQUIRE_CORROBORATION_FOR_HIGH_STAKES=true
SEARCH_ALLOW_PAID_FALLBACK=false
OPENAI_WEB_SEARCH_TOOL_ENABLED=false
BRAVE_SEARCH_API_ENABLED=false
# 旧設定。検索backendの選択には使わず、trueの場合もOpenAI内蔵検索を自動有効化しません。
AI_WEB_SEARCH_ENABLED=false
AI_MODEL_FAST=gpt-5.6-luna
AI_MODEL_BALANCED=gpt-5.6-terra
AI_MODEL_QUALITY=gpt-5.6-sol
# 複雑・Web・添付・成果物依頼だけに出すタスクカード。既定値は全guildで表示できるUnicodeです。
AI_STATUS_EMOJI_PROCESSING=🔄
AI_STATUS_EMOJI_DONE=✅
AI_STATUS_EMOJI_PENDING=▫️
AI_STATUS_EMOJI_FAILED=❌
# 外部providerでは32 UTF-8 bytes以上の専用ランダム値を推奨。placeholder/低entropy値は起動拒否します。
# 空欄はAPI key fallbackで動作しますが、runtime preflightは用途分離不足としてWARNを出します。
AI_SAFETY_IDENTIFIER_SECRET=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_RESPONSE_BYTES=2097152

# AIが「サイトを作って」と明示された時だけ、検証済みHTMLを専用originへ自動公開します。
# public-safe既定値は空です。自己管理する専用HTTPS originを明示し、他用途のdomainと分離してください。
SITE_PUBLISH_ENABLED=false
SITE_PUBLISH_AUTO_ENABLED=false
# 外部公開という副作用を明示的に許可する二重gate。公開基盤の準備完了後だけtrueにします。
SITE_PUBLISH_ALLOW_REMOTE=false
SITE_PUBLISH_BASE_URL=
SITE_PUBLISH_API_URL=
# WorkerのPUBLISH_HMAC_SECRETと同じ、UTF-8で32bytes以上の専用乱数。commit禁止です。
SITE_PUBLISH_HMAC_SECRET=
SITE_PUBLISH_TIMEOUT_SECONDS=20
SITE_PUBLISH_MAX_RESPONSE_BYTES=262144

# NASA APODは既定OFFです。ENABLED_PLUGINS、module/capability ONと合わせた時だけ固定APIを使います。
NASA_APOD_ALLOW_REMOTE=false
# NASA公式APIの専用key。DEMO_KEYはruntime readyとして扱いません。commit禁止です。
NASA_APOD_API_KEY=

# Cloudflare Browser Rendering screenshot経路は既定OFFです。strictなweb.browser.isolatedとは別機能です。
# trueにしてもcredential不足ではbot全体を起動失敗させず、このpluginだけready=falseにします。
CLOUDFLARE_BROWSER_RENDERING_ALLOW_REMOTE=false
# Fixed YouTube Browser Run recipe; separate default-OFF capability/readiness.
CLOUDFLARE_BROWSER_RUN_INTERACTIVE_ENABLED=false
CLOUDFLARE_BROWSER_RENDERING_ACCOUNT_ID=
# Cloudflare API token。Browser Rendering Edit/Writeの最小権限だけを付け、実値はcommitしないでください。
CLOUDFLARE_BROWSER_RENDERING_API_TOKEN=
CLOUDFLARE_BROWSER_RENDERING_TIMEOUT_SECONDS=45
CLOUDFLARE_BROWSER_RENDERING_MAX_OUTPUT_BYTES=8388608

# 公開YouTube URLを公式Gemini video inputへ直接渡す経路。既定OFF・BOT_OWNER限定です。
# Preview仕様、無料/有料tier、データ利用条件を確認してから明示的に有効化してください。
MEDIA_URL_INSPECTION_ALLOW_REMOTE=false
# Gemini Developer API専用key。実値はcommitしないでください。
MEDIA_URL_INSPECTION_API_KEY=
MEDIA_URL_INSPECTION_TIMEOUT_SECONDS=60
MEDIA_URL_INSPECTION_MAX_RESPONSE_BYTES=262144
# 0では外部POST禁止。課金条件を確認後、1日あたりの明示上限だけ設定してください。
MEDIA_URL_INSPECTION_DAILY_CALL_LIMIT=0
# 専用Hyper-V VMを使う場合だけtrue。起動probe失敗時はGeminiへ自動fallbackしません。
MEDIA_URL_INSPECTION_USE_HYPERV=false
MEDIA_URL_INSPECTION_HYPERV_TIMEOUT_SECONDS=60

# 自己進化は提案・テスト・所有者承認まで。直接merge/push/restartは行いません。
SELF_EVOLUTION_ENABLED=false

# Minecraft機能はモジュールとして保持しますが既定OFFです。
MINECRAFT_ENABLED=false
MINECRAFT_HOST=127.0.0.1
MINECRAFT_PORT=25565
MINECRAFT_TIMEOUT_SECONDS=3.0
# public IPへのstatus pingが必要な場合のみtrue。RCONは実装しません。
MINECRAFT_ALLOW_PUBLIC=false
MINECRAFT_MAX_PACKET_BYTES=32768

# 音声は既定OFF。VOICEVOX Engineをローカル起動した場合だけ有効化します。
VOICE_ENABLED=false
VOICEVOX_URL=http://127.0.0.1:50021
VOICE_ALLOW_REMOTE=false
VOICE_TIMEOUT_SECONDS=15
VOICE_MAX_RESPONSE_BYTES=26214400
# BOT自身が起動したVOICEVOXだけを停止する任意機能。既定OFF。
VOICEVOX_MANAGED_PROCESS_ENABLED=false
VOICEVOX_MANAGED_EXECUTABLE=
VOICEVOX_MANAGED_STARTUP_TIMEOUT_SECONDS=15
VOICEVOX_MANAGED_SHUTDOWN_TIMEOUT_SECONDS=8

# 音楽moduleは許可済みローカル音源だけをVCへ再生します。URL・任意path・YouTube音声抽出は受け付けません。
MUSIC_ENABLED=false
# 複数rootはセミコロン区切り。Bot利用者へ公開してよい音源だけを置いてください。
MUSIC_LIBRARY_ROOTS=media/music
MUSIC_DATABASE_PATH=
MUSIC_FFMPEG_PATH=
MUSIC_LIBRARY_MAX_FILES=5000
MUSIC_LIBRARY_MAX_FILE_BYTES=536870912
MUSIC_MAX_QUEUE=50
MUSIC_MAX_SPEECH_QUEUE=10
MUSIC_DEFAULT_VOLUME=0.65
# text channel/threadの明示routeを既存VOICEVOX→Music duckingへ流す機能。既定OFF、loopback VOICEVOXのみ。
MUSIC_READ_ALOUD_ENABLED=false
MUSIC_MAX_PLAYLISTS_PER_USER=50
MUSIC_MAX_TRACKS_PER_PLAYLIST=100

# durable job worker。execution timeout < lease、drain timeout < shutdown timeoutを必ず満たします。
JOBS_POLL_SECONDS=5
JOBS_BATCH_SIZE=10
JOBS_LEASE_SECONDS=60
JOBS_EXECUTION_TIMEOUT_SECONDS=45
JOBS_DRAIN_TIMEOUT_SECONDS=12
JOBS_BACKOFF_BASE_SECONDS=5
JOBS_BACKOFF_MAX_SECONDS=3600
JOBS_DISABLED_DEFER_SECONDS=300

# YonerAI Core連携は既定OFFです。実Coreの固定 /health とInternal Run API v0.1だけを使用します。
# loopback HTTPはremote opt-in/token不要です。remote HTTPSは二重opt-inとBearer tokenを必須にします。
YONERAI_ENABLED=false
YONERAI_ALLOW_REMOTE=false
YONERAI_REMOTE_STATUS_OPT_IN=false
YONERAI_AUTH_TOKEN=
YONERAI_CORE_ORIGIN=
YONERAI_TIMEOUT_SECONDS=5
YONERAI_MAX_RESPONSE_BYTES=65536
